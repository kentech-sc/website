{
	"name": "website",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": "24.18.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"fix": "prettier --write . && eslint src tests vite.config.ts eslint.config.js --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,css,scss}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@auth/sveltekit": "^1.10.0",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-vercel": "^6.1.2",
		"@sveltejs/kit": "^2.36.3",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^24.10.1",
		"@typescript-eslint/parser": "^8.61.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-import-x": "^4.16.2",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"prettier": "^3.4.2",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-svelte": "^3.3.3",
		"sass": "^1.90.0",
		"svelte": "^5.38.6",
		"svelte-check": "^4.3.1",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.61.0",
		"vite": "^7.2.4"
	},
	"dependencies": {
		"@lucide/svelte": "^0.542.0",
		"@sentry/sveltekit": "^10.27.0",
		"@tiptap/core": "^3.22.0",
		"@tiptap/extension-color": "^3.22.0",
		"@tiptap/extension-image": "^3.22.0",
		"@tiptap/extension-text-align": "^3.22.0",
		"@tiptap/extension-text-style": "^3.22.0",
		"@tiptap/starter-kit": "^3.22.0",
		"isomorphic-dompurify": "^2.33.0",
		"mongoose": "^8.18.0",
		"secure-s3-storage": "^2.0.0",
		"web-push": "^3.6.7"
	}
}

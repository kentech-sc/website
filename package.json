{
	"name": "website",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"generate:pwa-assets": "pwa-assets-generator",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"fix": "prettier --write . && eslint src vite.config.ts eslint.config.js --fix",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,css,scss}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@auth/sveltekit": "^1.11.2",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.1.1",
		"@typescript-eslint/parser": "^8.64.0",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"prettier": "^3.9.5",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.101.0",
		"svelte": "^5.56.5",
		"svelte-check": "^4.7.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.1.4",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.24.0",
		"@sentry/sveltekit": "^10.65.0",
		"@tiptap/core": "^3.27.4",
		"@tiptap/extension-color": "^3.27.4",
		"@tiptap/extension-image": "^3.27.4",
		"@tiptap/extension-text-align": "^3.27.4",
		"@tiptap/extension-text-style": "^3.27.4",
		"@tiptap/starter-kit": "^3.27.4",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"isomorphic-dompurify": "^3.18.0",
		"mongoose": "^9.7.4",
		"secure-s3-storage": "^2.0.0",
		"web-push": "^3.6.7"
	}
}
